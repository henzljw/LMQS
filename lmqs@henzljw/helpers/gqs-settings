# ---------------------------------------------------------------- window

class SettingsWindow(Gtk.ApplicationWindow):
    def __init__(self, app, store, schema, start_page):
        super().__init__(application=app, title="LMQS")
        self.store, self.schema = store, schema
        self.layout = schema.get("layout", {})
        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), self.css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.set_default_size(780, 860)
        self.set_icon_name("preferences-system")
        self.deps = []        # (widget, key it depends on)
        self.refreshers = {}  # key -> function to re-read the value into the widget
        self.option_deps = []  # (key, combobox key whose choices depend on it)
        self._building = False

        self.app_path = getattr(app.args, "path", "") if hasattr(app, "args") else ""
        self.meta = {}
        try:
            with open(os.path.join(self.app_path, "metadata.json")) as f:
                self.meta = json.load(f)
        except (OSError, ValueError):
            pass

        # Header: back button on inner pages, Reset on settings pages.
        self.header = Gtk.HeaderBar(show_close_button=True)
        self.header.set_title("LMQS")
        self.header.set_subtitle("Changes show live in Quick Settings")
        self.back_btn = Gtk.Button.new_from_icon_name("go-previous-symbolic", Gtk.IconSize.BUTTON)
        self.back_btn.set_tooltip_text("Back")
        self.back_btn.get_style_context().add_class("flat")
        self.back_btn.set_valign(Gtk.Align.CENTER)
        self.back_btn.connect("clicked", lambda *_: self._back())
        # Title area: [<] Title, side by side and centred, with the subtitle under the title.
        title_box = Gtk.Box(spacing=6)
        title_box.set_halign(Gtk.Align.CENTER)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        texts.set_valign(Gtk.Align.CENTER)
        self.title_label = Gtk.Label(label="LMQS")
        self.title_label.get_style_context().add_class("title")
        self.subtitle_label = Gtk.Label(label="")
        self.subtitle_label.get_style_context().add_class("subtitle")
        texts.pack_start(self.title_label, False, False, 0)
        texts.pack_start(self.subtitle_label, False, False, 0)
        title_box.pack_start(self.back_btn, False, False, 0)
        title_box.pack_start(texts, False, False, 0)
        self.header.set_custom_title(title_box)
        self.reset_btn = Gtk.Button()
        rbox = Gtk.Box(spacing=6)
        rbox.pack_start(Gtk.Image.new_from_icon_name("edit-undo-symbolic", Gtk.IconSize.BUTTON), False, False, 0)
        rbox.pack_start(Gtk.Label(label="Reset"), False, False, 0)
        self.reset_btn.add(rbox)
        self.reset_btn.set_tooltip_text("Reset settings to their defaults")
        self.reset_btn.connect("clicked", lambda *_: self._confirm_reset())
        self.header.pack_end(self.reset_btn)
        # Their visibility is managed per page, so the window's show_all() mustn't override it.
        rbox.show_all()
        self.back_btn.get_child().show() if self.back_btn.get_child() else None
        for b in (self.back_btn, self.reset_btn):
            b.set_no_show_all(True)
        self.set_titlebar(self.header)
        self.current_page = None
        self.history = []
        self.titles = {}

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT, transition_duration=220)
        self.stack.get_style_context().add_class("gqs-bg")
        self.add(self.stack)

        # Home: app header + a list of pages, like GNOME's About/preferences windows.
        self._add_page("home", "LMQS", self._build_home())
        for page in self.layout.get("pages", []):
            self._build_page(page)
        self._add_page("about", "About", self._build_about())
        self._add_page("about-details", "Details", self._build_details())
        self._add_page("about-credits", "Credits", self._build_credits())
        self._add_page("about-legal", "Legal", self._build_legal())

        self._show("home", animate=False)
        if start_page and start_page != "home" and self.stack.get_child_by_name(start_page):
            self._go(start_page, animate=False)
        self.apply_style()
        self._update_deps()

        mon = Gio.File.new_for_path(store.path)
        try:
            self.monitor = mon.monitor_file(Gio.FileMonitorFlags.NONE, None)
            self.monitor.connect("changed", self._on_file_changed)
        except GLib.Error:
            self.monitor = None

    # ---- look
    def apply_style(self):
        card = self.store.get("card-style")
        settings = Gtk.Settings.get_default()
        if card == "system":
            theme = (settings.get_property("gtk-theme-name") or "").lower()
            dark = "dark" in theme
        else:
            dark = card != "light"
        settings.set_property("gtk-application-prefer-dark-theme", dark)
        try:
            self.css.load_from_data((gnome_css() + accent_css(self.store.get("accent-color"))).encode())
        except GLib.Error:
            self.css.load_from_data(gnome_css().encode())

    # ---- navigation
    def _clamp(self, width=620):
        clamp = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, margin=28)
        clamp.set_halign(Gtk.Align.CENTER)
        clamp.set_size_request(width, -1)
        return clamp

    def _add_page(self, name, title, content):
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroller.add(content)
        scroller.show_all()   # a hidden page can't be made the visible one
        self.stack.add_named(scroller, name)
        self.titles[name] = title

    def _build_page(self, page):
        info = self.layout.get(page, {})
        clamp = self._clamp()
        for section in info.get("sections", []):
            clamp.pack_start(self._build_section(section), False, False, 0)
        self._add_page(page, info.get("title", page), clamp)

    def _show(self, name, animate=True, back=False):
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_RIGHT if back else Gtk.StackTransitionType.SLIDE_LEFT)
        self.stack.set_transition_duration(220 if animate else 0)
        self.stack.set_visible_child_name(name)
        self.current_page = name
        home = name == "home"
        self.title_label.set_text("LMQS" if home else self.titles.get(name, ""))
        sub = "Changes show live in Quick Settings" if (home or name.startswith("page-")) else ""
        self.subtitle_label.set_text(sub)
        self.subtitle_label.set_visible(bool(sub))
        self.subtitle_label.set_no_show_all(True)
        self.back_btn.set_visible(not home)
        self.reset_btn.set_visible(home or name.startswith("page-"))

    def _go(self, name, animate=True):
        if name == self.current_page:
            return
        self.history.append(self.current_page)
        self._show(name, animate)

    def _back(self):
        if self.history:
            self._show(self.history.pop() or "home", back=True)

    def _select(self, page):     # kept for older callers
        if self.stack.get_child_by_name(page):
            self._go(page)

    # ---- building blocks
    def _hero(self, title, subtitle=None):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        img = Gtk.Image.new_from_icon_name("preferences-system", Gtk.IconSize.DIALOG)
        img.set_pixel_size(112)
        img.get_style_context().add_class("hero-icon")
        box.pack_start(img, False, False, 0)
        t = Gtk.Label(label=title)
        t.get_style_context().add_class("hero-title")
        box.pack_start(t, False, False, 0)
        a = Gtk.Label(label=self.meta.get("author", "Henry henz"))
        a.get_style_context().add_class("hero-sub")
        box.pack_start(a, False, False, 0)
        pill = Gtk.Label(label=self.meta.get("version", "") or "-")
        pill.get_style_context().add_class("version-pill")
        pill.set_halign(Gtk.Align.CENTER)
        box.pack_start(pill, False, False, 2)
        if subtitle:
            st = Gtk.Label(label=subtitle, wrap=True, justify=Gtk.Justification.CENTER)
            st.get_style_context().add_class("hero-sub")
            box.pack_start(st, False, False, 0)
        return box

    def _boxed(self, rows):
        """Rounded list of rows with thin lines between them."""
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.get_style_context().add_class("boxed")
        for i, row in enumerate(rows):
            if i:
                card.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)
            ctx = row.get_style_context()
            if i == 0:
                ctx.add_class("first")
            if i == len(rows) - 1:
                ctx.add_class("last")
            card.pack_start(row, False, False, 0)
        return card

    def _nav_row(self, title, target, icon=None, hint=None):
        btn = Gtk.Button()
        btn.get_style_context().add_class("nav-row")
        box = Gtk.Box(spacing=14)
        if icon:
            box.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        labels.set_valign(Gtk.Align.CENTER)
        t = Gtk.Label(label=title, xalign=0)
        t.get_style_context().add_class("nav-title")
        labels.pack_start(t, False, False, 0)
        if hint:
            h = Gtk.Label(label=hint, xalign=0)
            h.set_ellipsize(Pango.EllipsizeMode.END)
            h.get_style_context().add_class("nav-hint")
            labels.pack_start(h, False, False, 0)
        box.pack_start(labels, True, True, 0)
        box.pack_end(Gtk.Image.new_from_icon_name("go-next-symbolic", Gtk.IconSize.BUTTON), False, False, 0)
        btn.add(box)
        btn.connect("clicked", lambda *_: self._go(target))
        return btn

    def _info_row(self, key, value, link=None):
        row = Gtk.Box(spacing=16)
        row.get_style_context().add_class("info-row")
        k = Gtk.Label(label=key, xalign=0)
        k.get_style_context().add_class("info-key")
        row.pack_start(k, False, False, 0)
        if link:
            v = Gtk.LinkButton.new_with_label(link, value)
            v.set_halign(Gtk.Align.END)
        else:
            v = Gtk.Label(label=value, xalign=1, wrap=True, selectable=True)
            v.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            v.set_max_width_chars(48)
        row.pack_end(v, False, False, 0)
        return row

    def _text_block(self, text):
        lab = Gtk.Label(label=text, xalign=0, wrap=True, selectable=True)
        lab.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        lab.get_style_context().add_class("legal-text")
        return lab

    # ---- home and about pages
    def _build_home(self):
        clamp = self._clamp()
        clamp.pack_start(self._hero(self.meta.get("name") or "LMQS",
                                    "Linux Mint Quick Settings. Changes show up live in the preview."), False, False, 0)
