# ---------------------------------------------------------------- colours

def parse_color(text):
    text = str(text or "")
    m = re.search(r"rgba?\(([^)]+)\)", text)
    if m:
        parts = [float(x) for x in m.group(1).split(",")[:3]]
        return tuple(int(round(v)) for v in parts)
    m = re.match(r"#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})", text, re.I)
    if m:
        return tuple(int(g, 16) for g in m.groups())
    return (53, 132, 228)


def hexc(rgb):
    return "#%02x%02x%02x" % rgb


# ---------------------------------------------------------------- settings file

class Store:
    """Cinnamon's per-instance settings JSON: {key: {type, default, value, ...}}."""

    def __init__(self, uuid, instance, schema, path=None):
        self.schema = schema
        self.path = path if path and os.path.exists(path) else self._find(uuid, instance)
        self._adopt_stray(uuid, instance)
        self.data = {}
        self.muted_until = 0
        self.load()

    BASES = [os.path.expanduser("~/.config/cinnamon/spices"), os.path.expanduser("~/.cinnamon/configs")]

    @classmethod
    def _find(cls, uuid, instance):
        bases = cls.BASES
        # Single-instance applets (like this one) use "<uuid>.json"; others use "<instance>.json".
        for base in bases:
            for name in ("%s.json" % uuid, "%s.json" % instance):
                p = os.path.join(base, uuid, name)
                if os.path.exists(p):
                    return p
        for base in bases:
            d = os.path.join(base, uuid)
            if os.path.isdir(d):
                files = sorted(f for f in os.listdir(d) if re.match(r"^\d+\.json$", f))
                if files:
                    return os.path.join(d, files[0])
        return os.path.join(bases[0], uuid, "%s.json" % instance)

    def _adopt_stray(self, uuid, instance):
        """Version 3.0 could save into "<instance>.json" by mistake; move those changes over."""
        stray = os.path.join(os.path.dirname(self.path), "%s.json" % instance)
        if stray == self.path or not os.path.exists(stray) or not os.path.exists(self.path):
            return
        try:
            with open(stray) as f:
                changes = json.load(f)
            with open(self.path) as f:
                real = json.load(f)
            if os.path.getmtime(stray) > os.path.getmtime(self.path):
                for key, entry in changes.items():
                    if isinstance(entry, dict) and "value" in entry and key in self.schema:
                        real.setdefault(key, dict(self.schema[key]))["value"] = entry["value"]
                with open(self.path, "w") as f:
                    json.dump(real, f, indent=4)
            os.replace(stray, stray + ".gqs-stray.bak")
        except (OSError, ValueError):
            pass

    def load(self):
        try:
            with open(self.path) as f:
                self.data = json.load(f)
        except (OSError, ValueError):
            self.data = {}

    def get(self, key):
        entry = self.data.get(key)
        if isinstance(entry, dict) and "value" in entry:
            return entry["value"]
        return self.schema.get(key, {}).get("default")

    def set(self, key, value):
        self.load()   # pick up anything the applet wrote meanwhile
        entry = self.data.get(key)
        if not isinstance(entry, dict):
            entry = dict(self.schema.get(key, {}))
            self.data[key] = entry
        entry["value"] = value
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        self.muted_until = time.monotonic() + 0.8
        with open(self.path, "w") as f:
            json.dump(self.data, f, indent=4)

    def set_many(self, values):
        """Write several keys in one save, so Quick Settings applies them in one go."""
        self.load()
        for key, value in values.items():
            entry = self.data.get(key)
            if not isinstance(entry, dict):
                entry = dict(self.schema.get(key, {}))
                self.data[key] = entry
            entry["value"] = value
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        self.muted_until = time.monotonic() + 0.8
        with open(self.path, "w") as f:   # same way as set(), which Quick Settings watches
            json.dump(self.data, f, indent=4)


# ---------------------------------------------------------------- styles

def accent_css(accent):
    """Everything that shows an "on" or main action uses Quick Settings' accent colour:
    switches, the main buttons, selections, focus rings, links and the version pill."""
    r, g, b = parse_color(accent)
    fg = "#ffffff" if (0.299 * r + 0.587 * g + 0.114 * b) < 160 else "#000000"
    c = "rgb(%d,%d,%d)" % (r, g, b)
    return """
@define-color gqs_accent %(c)s;
@define-color gqs_accent_fg %(fg)s;

/* switches: drawn completely here (rounded track, round knob), because some themes such as
   Mint-Y draw them with pictures, and recolouring those left a square track. */
switch {
    background-image: none; background-color: alpha(@theme_fg_color, 0.2);
    border: none; border-radius: 999px; box-shadow: none; outline-offset: -2px;
    padding: 2px; min-height: 22px; color: transparent;
}
switch:hover { background-color: alpha(@theme_fg_color, 0.28); }
switch slider {
    background-image: none; background-color: #ffffff;
    border: none; border-radius: 999px; box-shadow: 0 1px 2px alpha(black, 0.3);
    min-width: 22px; min-height: 22px; margin: 0; outline: none;
}
switch image, switch label { color: transparent; opacity: 0; }
switch:checked { background-color: @gqs_accent; }
switch:checked:hover { background-color: shade(@gqs_accent, 1.08); }
switch:backdrop { background-color: alpha(@theme_fg_color, 0.15); }
switch:checked:backdrop { background-color: alpha(@gqs_accent, 0.8); }
switch:disabled { opacity: 0.5; }

/* main action buttons (Add, Save, Yes, Add Tile...) */
button.suggested-action { background-color: @gqs_accent; background-image: none; border-color: shade(@gqs_accent, 0.85); color: @gqs_accent_fg; box-shadow: none; text-shadow: none; -gtk-icon-shadow: none; }
button.suggested-action label, button.suggested-action image { color: @gqs_accent_fg; }
button.suggested-action:hover { background-color: shade(@gqs_accent, 1.08); background-image: none; }
button.suggested-action:active { background-color: shade(@gqs_accent, 0.92); background-image: none; }
button.suggested-action:disabled { background-color: alpha(@gqs_accent, 0.4); }

/* check boxes and radio buttons */
check:checked, radio:checked { background-color: @gqs_accent; background-image: none; border-color: shade(@gqs_accent, 0.85); color: @gqs_accent_fg; }

/* selected rows, text selection, focus and links */
list row:selected, row:selected, treeview:selected { background-color: @gqs_accent; color: @gqs_accent_fg; }
list row:selected label, row:selected label { color: @gqs_accent_fg; }
selection, entry selection, label selection { background-color: @gqs_accent; color: @gqs_accent_fg; }
entry:focus, spinbutton:focus, combobox button:focus { border-color: @gqs_accent; box-shadow: inset 0 0 0 1px @gqs_accent; }
scale highlight, progressbar progress { background-color: @gqs_accent; background-image: none; border-color: @gqs_accent; }
*:link, button.link label, .link { color: @gqs_accent; }

/* pages */
.version-pill { background-color: alpha(@gqs_accent, 0.16); color: @gqs_accent; }
.nav-row:focus .nav-title { color: @gqs_accent; }
""" % {"c": c, "fg": fg}


