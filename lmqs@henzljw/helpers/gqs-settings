        on_cmd = Gtk.Entry(text=t.get("on", ""), placeholder_text="e.g. nmcli connection up MyVPN")
        off_cmd = Gtk.Entry(text=t.get("off", ""), placeholder_text="e.g. nmcli connection down MyVPN")
        st_cmd = Gtk.Entry(text=t.get("status", ""), placeholder_text="Optional: succeeds when it's on")
        for r, (label, w) in enumerate((("On command", on_cmd), ("Off command", off_cmd), ("Status command", st_cmd))):
            cmd_page.attach(Gtk.Label(label=label, xalign=1), 0, r, 1, 1)
            w.set_hexpand(True)
            cmd_page.attach(w, 1, r, 1, 1)
        chint = Gtk.Label(label="Commands run in a shell as you (no password prompts). The status command decides whether "
                                "the tile shows as on: it's on when the command succeeds (exit code 0). Without one, "
                                "the tile remembers the last state you set.", xalign=0, wrap=True)
        chint.get_style_context().add_class("row-hint")
        cmd_page.attach(chint, 0, 3, 2, 1)
        stack.add_named(cmd_page, "command")

        def kind_changed(*_):
            stack.set_visible_child_name(kind.get_active_id())
            if not icon_entry.get_text().strip():
                icon_entry.set_text({"open": "folder-symbolic", "command": "system-run-symbolic"}.get(kind.get_active_id(), ""))
        kind.connect("changed", kind_changed)
        dlg.show_all()
        stack.set_visible_child_name(t.get("kind", "app"))

        while True:
            if dlg.run() != Gtk.ResponseType.OK:
                dlg.destroy()
                return
            k = kind.get_active_id()
            problem = None
            if k == "app" and not selected.get("id"):
                problem = "Choose an app from the list."
            elif k == "open" and not target.get_text().strip():
                problem = "Enter a folder or website."
            elif k == "command" and not (on_cmd.get_text().strip() or off_cmd.get_text().strip()):
                problem = "Enter at least an On or Off command."
            elif not name.get_text().strip():
                problem = "Give the tile a name."
            if not problem:
                break
            err = Gtk.MessageDialog(transient_for=dlg, modal=True, message_type=Gtk.MessageType.WARNING,
                                    buttons=Gtk.ButtonsType.OK, text=problem)
            err.run(); err.destroy()

        t.update({"kind": k, "name": name.get_text().strip(), "icon": icon_entry.get_text().strip()})
        for f in ("app", "target", "on", "off", "status"):
            t.pop(f, None)
        if k == "app":
            t["app"] = selected["id"]
        elif k == "open":
            t["target"] = target.get_text().strip()
        else:
            t.update({"on": on_cmd.get_text().strip(), "off": off_cmd.get_text().strip(), "status": st_cmd.get_text().strip()})
        if not t["icon"]:
            t["icon"] = {"open": "folder-symbolic", "command": "system-run-symbolic"}.get(k, "application-x-executable-symbolic")
        dlg.destroy()

        tiles = [x for x in (self.store.get(key) or []) if isinstance(x, dict)]
        layout = [r for r in (self.store.get("toggle-layout") or []) if isinstance(r, dict)]
        if new:
            # Put it in Quick Settings now, or keep it in the hidden tiles for later?
            ask = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                    buttons=Gtk.ButtonsType.NONE, text='Add "%s" to Quick Settings?' % t["name"])
            ask.format_secondary_text("Yes puts the tile in Quick Settings now. No keeps it with the hidden tiles; "
                                      "you can add it later with the pencil button or on the Tiles page.")
            ask.add_button("No, Keep Hidden", Gtk.ResponseType.NO)
            yes = ask.add_button("Yes, Add It", Gtk.ResponseType.YES)
            yes.get_style_context().add_class("suggested-action")
            ask.set_default_response(Gtk.ResponseType.YES)
            show = ask.run() == Gtk.ResponseType.YES
            ask.destroy()
            tiles.append(t)
            layout.append({"item": "custom:%s" % t["id"], "show": show})
        else:
            tiles = [t if x.get("id") == t["id"] else x for x in tiles]
        self._save_custom(key, tiles, layout)

    def _move_tile(self, key, i, step):
        rows = list(self.store.get(key) or [])
        j = i + step
        if 0 <= j < len(rows):
            rows[i], rows[j] = rows[j], rows[i]
            self._set(key, rows)
            self.refreshers[key]()

    def _show_tile(self, key, i, on):
        rows = [dict(r) for r in (self.store.get(key) or [])]
        if i < len(rows) and rows[i].get("show", True) != on:
            rows[i]["show"] = on
            self._set(key, rows)
            GLib.idle_add(lambda: (self.refreshers[key](), False)[1])

    # ---- reset to defaults
    def _page_keys(self, page):
        keys = []
        for section in self.layout.get(page, {}).get("sections", []):
            for key in self.layout.get(section, {}).get("keys", []):
                if key in self.schema and "default" in self.schema[key] and key not in keys:
                    keys.append(key)
        return keys

    def _confirm_reset(self):
        page = self.current_page if (self.current_page or "").startswith("page-") else None
        title = self.layout.get(page, {}).get("title", "this page") if page else None
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.NONE, text="Reset to Defaults?")
        everything_text = ("everything (tiles and their order, custom tiles, sliders, top row, panel icons, "
                           "battery and appearance)")
        dlg.format_secondary_text(
            "Start your Quick Settings customization from scratch. Reset %s. "
            "Remembered states such as your refresh rate and keyboard lighting are kept."
            % (("just the %s page, or %s" % (title, everything_text)) if page else everything_text))
        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        if page:
            dlg.add_button("Reset %s Page" % title, 1)
        everything = dlg.add_button("Reset Everything", 2)
        everything.get_style_context().add_class("destructive-action")
        dlg.set_default_response(Gtk.ResponseType.CANCEL)
        resp = dlg.run()
        dlg.destroy()
        if resp == 1 and page:
            self._reset(self._page_keys(page))
        elif resp == 2:
            keys = []
            for pg in self.layout.get("pages", []):
                keys += [k for k in self._page_keys(pg) if k not in keys]
            self._reset(keys)

    def _reset(self, keys):
        if not keys:
            return
        values = {k: json.loads(json.dumps(self.schema[k]["default"])) for k in keys}
        self.store.set_many(values)   # Quick Settings picks this up and animates to the defaults
        self.store.muted_until = time.monotonic() + 0.8
        self._building = False
        for key in keys:
            if key in self.refreshers:
                self.refreshers[key]()
        self.apply_style()
        self._update_deps()

    # ---- saving and live updates
    def _set(self, key, value):
        if self._building:
            return
        self.store.set(key, value)
        for dep, target in self.option_deps:
            if dep == key and target in self.refreshers:
                self.refreshers[target]()
        if key in ("card-style", "accent-color"):
            self.apply_style()
            if "accent-color" in self.refreshers:
                self.refreshers["accent-color"]()
        self._update_deps()

    def _update_deps(self):
        for widget, dep in self.deps:
            widget.set_sensitive(bool(self.store.get(dep)))

    def _on_file_changed(self, _mon, _f, _o, event):
        if event not in (Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED):
            return
        if time.monotonic() < self.store.muted_until:
            return
        self.store.load()
        for fn in self.refreshers.values():
            fn()
        self.apply_style()
        self._update_deps()


class App(Gtk.Application):
    def __init__(self, args):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.args = args
        self.win = None

    def do_activate(self):
        if self.win:            # already open: bring it to the front
            self.win.present()
            return
        with open(os.path.join(self.args.path, "settings-schema.json")) as f:
            schema = json.load(f)
        store = Store(self.args.uuid, self.args.instance, schema, self.args.file)
        self.win = SettingsWindow(self, store, schema, self.args.page)
        self.win.show_all()
        self._place_left(self.win)
        self.win.present()

    @staticmethod
    def _place_left(win):
        # Quick Settings is pinned open on the right as a live preview; keep this window clear of it.
        try:
            display = Gdk.Display.get_default()
            mon = display.get_primary_monitor() or display.get_monitor(0)
            area = mon.get_workarea()
            w, h = win.get_size()
            win.resize(min(w, max(640, area.width - 460)), min(h, area.height - 48))
            win.move(area.x + 24, area.y + 24)
        except Exception:
            pass


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--uuid", default="lmqs@henzljw")
    parser.add_argument("--instance", default="0")
    parser.add_argument("--path", default=os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    parser.add_argument("--page", default="home")
    parser.add_argument("--file", default=None, help="the applet's settings file (passed by the applet)")
    args = parser.parse_args()
    GLib.set_prgname("gqs-settings")
    GLib.set_application_name("LMQS")
    return App(args).run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
