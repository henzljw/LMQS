    def _row(self, text, widget, hint=None):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        row.get_style_context().add_class("row")
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lab = Gtk.Label(label=text, xalign=0, wrap=True)
        lab.get_style_context().add_class("row-label")
        labels.pack_start(lab, False, False, 0)
        if hint:
            h = Gtk.Label(label=hint, xalign=0, wrap=True)
            h.get_style_context().add_class("row-hint")
            labels.pack_start(h, False, False, 0)
        row.pack_start(labels, True, True, 0)
        widget.set_valign(Gtk.Align.CENTER)
        row.pack_end(widget, False, False, 0)
        return row

    def _build_row(self, key):
        spec = self.schema.get(key, {})
        kind = spec.get("type")
        desc = spec.get("description", key)
        row = None
        if kind == "generic" and key == "custom-tiles":
            return self._build_custom_tiles(key)
        if kind == "label":
            row = Gtk.Label(label=desc, xalign=0, wrap=True)
            row.get_style_context().add_class("help")
            row.set_margin_start(16); row.set_margin_end(16); row.set_margin_top(8); row.set_margin_bottom(4)
            return row
        if kind == "switch":
            sw = Gtk.Switch()
            def refresh(sw=sw):
                self._building = True
                sw.set_active(bool(self.store.get(key)))
                self._building = False
            refresh()
            sw.connect("notify::active", lambda w, *_: self._set(key, w.get_active()))
            self.refreshers[key] = refresh
            row = self._row(desc, sw, spec.get("tooltip"))
        elif kind == "combobox":
            combo = Gtk.ComboBoxText()
            all_options = list(spec.get("options", {}).items())
            options = list(all_options)
            hide = spec.get("gqs-hide-options")   # some choices only make sense with another setting
            def refresh(combo=combo, key=key, hide=hide, all_options=all_options):
                self._building = True
                shown = all_options
                if hide and self.store.get(hide["key"]) == hide["equals"]:
                    shown = [(l, v) for (l, v) in all_options if v not in hide["hide"]]
                    if self.store.get(key) in hide["hide"]:
                        self.store.set(key, hide["fallback"])
                options[:] = shown
                combo.remove_all()
                for label, _value in shown:
                    combo.append_text(label)
                cur = self.store.get(key)
                if key == "panel-battery-time" and isinstance(cur, bool):
                    cur = "panel" if cur else "off"   # was an on/off switch in 3.4.0
                idx = next((i for i, (_l, v) in enumerate(options) if str(v) == str(cur)), 0)
                combo.set_active(idx)
                self._building = False
            refresh()
            combo.connect("changed", lambda w, options=options: self._set(key, options[w.get_active()][1]) if w.get_active() >= 0 else None)
            if hide:
                self.option_deps.append((hide["key"], key))
            self.refreshers[key] = refresh
            row = self._row(desc, combo, spec.get("tooltip"))
        elif kind == "colorchooser":
            row = self._build_color_row(key, desc)
        elif kind == "list":
            row = self._build_tile_list(key)
        if row is not None and spec.get("dependency"):
            self.deps.append((row, spec["dependency"]))
        return row

    def _build_color_row(self, key, desc):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        buttons = []
        for name, hx in SWATCHES:
            b = Gtk.Button(tooltip_text=name)
            b.get_style_context().add_class("swatch")
            prov = Gtk.CssProvider()
            prov.load_from_data(("button.swatch { background-color: %s; }" % hx).encode())
            b.get_style_context().add_provider(prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
            rgb = parse_color(hx)
            b.connect("clicked", lambda _b, rgb=rgb: self._set(key, "rgb(%d,%d,%d)" % rgb))
            buttons.append((b, rgb))
            box.pack_start(b, False, False, 0)
        picker = Gtk.ColorButton(title="Accent colour")
        picker.set_use_alpha(False)
        def picked(w):
            c = w.get_rgba()
            self._set(key, "rgb(%d,%d,%d)" % (round(c.red * 255), round(c.green * 255), round(c.blue * 255)))
        picker.connect("color-set", picked)
        box.pack_start(picker, False, False, 4)
        def refresh():
            cur = parse_color(self.store.get(key))
            rgba = Gdk.RGBA(); rgba.parse(hexc(cur))
            picker.set_rgba(rgba)
            for b, rgb in buttons:
                ctx = b.get_style_context()
                (ctx.add_class if rgb == cur else ctx.remove_class)("selected")
        refresh()
        self.refreshers[key] = refresh
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        outer.get_style_context().add_class("row")
        lab = Gtk.Label(label=desc, xalign=0)
        lab.get_style_context().add_class("row-label")
        outer.pack_start(lab, False, False, 0)
        outer.pack_start(box, False, False, 0)
        return outer

    def _build_tile_list(self, key):
        holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=10)

        def refresh():
            for child in holder.get_children():
                holder.remove(child)
            rows = [dict(r) for r in (self.store.get(key) or []) if isinstance(r, dict)]
            for i, r in enumerate(rows):
                line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                line.get_style_context().add_class("tile-row")
                if not r.get("show", True):
                    line.get_style_context().add_class("hidden-tile")
                texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
                texts.set_valign(Gtk.Align.CENTER)
                name = Gtk.Label(label=self._tile_label(r.get("item", "?")), xalign=0)
                name.get_style_context().add_class("row-label")
                texts.pack_start(name, False, False, 0)
                about = self._tile_about(r.get("item", ""))
                if about:
                    hint = Gtk.Label(label=about, xalign=0, wrap=True)
                    hint.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
                    hint.set_max_width_chars(60)
                    hint.get_style_context().add_class("row-hint")
                    texts.pack_start(hint, False, False, 0)
                line.pack_start(texts, True, True, 0)
                up = Gtk.Button.new_from_icon_name("go-up-symbolic", Gtk.IconSize.BUTTON)
                down = Gtk.Button.new_from_icon_name("go-down-symbolic", Gtk.IconSize.BUTTON)
                for b, tip in ((up, "Move up"), (down, "Move down")):
                    b.get_style_context().add_class("icon")
                    b.set_tooltip_text(tip)
                up.set_sensitive(i > 0)
                down.set_sensitive(i < len(rows) - 1)
                up.connect("clicked", lambda _b, i=i: self._move_tile(key, i, -1))
                down.connect("clicked", lambda _b, i=i: self._move_tile(key, i, 1))
                sw = Gtk.Switch(active=r.get("show", True), valign=Gtk.Align.CENTER)
                sw.set_tooltip_text("Show this tile")
                sw.connect("notify::active", lambda w, _p, i=i: self._show_tile(key, i, w.get_active()))
                line.pack_end(sw, False, False, 0)
                line.pack_end(down, False, False, 0)
                line.pack_end(up, False, False, 0)
                holder.pack_start(line, False, False, 0)
            holder.show_all()

        refresh()
        self.refreshers[key] = refresh
        return holder

    def _tile_about(self, item):
        """One line on what a tile does (custom tiles: what they open or run)."""
        if str(item).startswith("custom:"):
            for t in self.store.get("custom-tiles") or []:
                if isinstance(t, dict) and "custom:" + str(t.get("id")) == item:
                    return self._custom_summary(t)
            return ""
        return TILE_INFO.get(item, "")

    def _tile_label(self, item):
        if str(item).startswith("custom:"):
            for t in self.store.get("custom-tiles") or []:
                if isinstance(t, dict) and "custom:" + str(t.get("id")) == item:
                    return "%s  (custom)" % (t.get("name") or "Custom tile")
            return "Custom tile"
        return item

    # ---- custom tiles
    KIND_TEXT = {"app": "Opens an app", "open": "Opens a folder or website", "command": "Runs commands (on/off)"}

    def _build_custom_tiles(self, key):
        holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=10)

        def refresh():
            for child in holder.get_children():
                holder.remove(child)
            add = Gtk.Button()
            ab = Gtk.Box(spacing=6)
            ab.pack_start(Gtk.Image.new_from_icon_name("list-add-symbolic", Gtk.IconSize.BUTTON), False, False, 0)
            ab.pack_start(Gtk.Label(label="Add Tile…"), False, False, 0)
            add.add(ab)
            add.get_style_context().add_class("suggested-action")
            add.set_halign(Gtk.Align.START)
            add.set_margin_bottom(6)
            add.connect("clicked", lambda *_: self._edit_custom(key, None))
            holder.pack_start(add, False, False, 0)
            tiles = [t for t in (self.store.get(key) or []) if isinstance(t, dict)]
            if not tiles:
                empty = Gtk.Label(label="No custom tiles yet. Add one to open an app, a folder or website, or to run your own on/off commands.",
                                  xalign=0, wrap=True)
                empty.get_style_context().add_class("row-hint")
                holder.pack_start(empty, False, False, 4)
            for t in tiles:
                line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                line.get_style_context().add_class("tile-row")
                line.pack_start(self._icon_image(t.get("icon"), 24), False, False, 0)
                labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
                n = Gtk.Label(label=t.get("name") or "Custom tile", xalign=0)
                n.get_style_context().add_class("row-label")
                h = Gtk.Label(label=self._custom_summary(t), xalign=0)
                h.set_ellipsize(Pango.EllipsizeMode.END)
                h.get_style_context().add_class("row-hint")
                labels.pack_start(n, False, False, 0)
                labels.pack_start(h, False, False, 0)
                line.pack_start(labels, True, True, 0)
                edit = Gtk.Button.new_from_icon_name("document-edit-symbolic", Gtk.IconSize.BUTTON)
                edit.set_tooltip_text("Edit")
                delete = Gtk.Button.new_from_icon_name("user-trash-symbolic", Gtk.IconSize.BUTTON)
                delete.set_tooltip_text("Remove")
                for b in (edit, delete):
                    b.get_style_context().add_class("icon")
                    b.set_valign(Gtk.Align.CENTER)
                edit.connect("clicked", lambda _b, t=t: self._edit_custom(key, t))
                delete.connect("clicked", lambda _b, t=t: self._delete_custom(key, t))
                line.pack_end(delete, False, False, 0)
                line.pack_end(edit, False, False, 0)
                holder.pack_start(line, False, False, 0)
            holder.show_all()

        refresh()
        self.refreshers[key] = refresh
        return holder

    def _custom_summary(self, t):
        kind = t.get("kind")
        if kind == "app":
            info = self._app_info(t.get("app"))
            return "Opens %s" % (info.get_display_name() if info else (t.get("app") or "an app") + " (not found)")
        if kind == "open":
            return "Opens %s" % (t.get("target") or "nothing yet")
        return "On: %s" % (t.get("on") or "-")

    @staticmethod
    def _app_info(app_id):
        if not app_id:
            return None
        try:
            return Gio.DesktopAppInfo.new(app_id)
        except (TypeError, GLib.Error):
            return None

    @staticmethod
    def _set_icon(img, icon, size):
        """Icon name, image file, or a saved GIcon string (what apps report)."""
        try:
            img.set_from_gicon(Gio.Icon.new_for_string(icon or "application-x-executable-symbolic"), Gtk.IconSize.LARGE_TOOLBAR)
        except (GLib.Error, TypeError):
            img.set_from_icon_name("application-x-executable-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
        img.set_pixel_size(size)
        return img

    @classmethod
    def _icon_image(cls, icon, size):
        return cls._set_icon(Gtk.Image(), icon, size)

    def _delete_custom(self, key, tile):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.NONE, text='Remove "%s"?' % (tile.get("name") or "Custom tile"))
        dlg.format_secondary_text("The tile is removed from Quick Settings.")
        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        b = dlg.add_button("Remove", Gtk.ResponseType.OK)
        b.get_style_context().add_class("destructive-action")
        resp = dlg.run()
        dlg.destroy()
        if resp != Gtk.ResponseType.OK:
            return
        tiles = [t for t in (self.store.get(key) or []) if isinstance(t, dict) and t.get("id") != tile.get("id")]
        layout = [r for r in (self.store.get("toggle-layout") or []) if isinstance(r, dict) and r.get("item") != "custom:%s" % tile.get("id")]
        self._save_custom(key, tiles, layout)

    def _save_custom(self, key, tiles, layout):
        self.store.set_many({key: tiles, "toggle-layout": layout})
        for k in (key, "toggle-layout"):
            if k in self.refreshers:
                self.refreshers[k]()

    def _edit_custom(self, key, tile):
        new = tile is None
        t = dict(tile or {"id": "%x" % int(time.time() * 1000), "kind": "app", "name": "", "icon": ""})
        dlg = Gtk.Dialog(title="Add Tile" if new else "Edit Tile", transient_for=self, modal=True)
