        apps.set_selection_mode(Gtk.SelectionMode.SINGLE)
        sc.add(apps)
        app_page.pack_start(sc, True, True, 0)
        infos = sorted((a for a in Gio.AppInfo.get_all() if a.should_show() and a.get_id()),
                       key=lambda a: a.get_display_name().lower())
        selected = {"id": t.get("app")}
