{
    "layout": {
        "type": "layout",
        "pages": [
            "page-toggles",
            "page-custom",
            "page-layout",
            "page-panel",
            "page-appearance"
        ],
        "page-layout": {
            "type": "page",
            "title": "Layout",
            "sections": [
                "sec-sliders",
                "sec-top",
                "sec-extras"
            ]
        },
        "page-toggles": {
            "type": "page",
            "title": "Tiles",
            "sections": [
                "sec-toggles"
            ]
        },
        "page-custom": {
            "type": "page",
            "title": "Custom Tiles",
            "sections": [
                "sec-custom"
            ]
        },
        "sec-custom": {
            "type": "section",
            "title": "Your tiles",
            "keys": [
                "custom-tiles-help",
                "custom-tiles"
            ]
        },
        "sec-toggles": {
            "type": "section",
            "title": "Toggles",
            "keys": [
                "toggles-help",
                "toggle-layout"
            ]
        },
        "sec-sliders": {
            "type": "section",
            "title": "Sliders",
            "keys": [
                "slider-volume",
                "scroll-volume-slider",
                "output-picker",
                "slider-brightness",
                "scroll-brightness-slider",
                "mic-slider",
                "scroll-mic-slider",
                "input-picker"
            ]
        },
        "sec-top": {
            "type": "section",
            "title": "Top row",
            "keys": [
                "show-battery-pill",
                "show-screenshot",
                "show-customize",
                "show-configure",
                "show-settings",
                "show-lock",
                "show-power"
            ]
        },
        "sec-extras": {
            "type": "section",
            "title": "Extras",
            "keys": [
                "show-media-card",
                "show-notifications",
                "notifications-position",
                "notif-compact",
                "refresh-rate-remember",
                "bt-at-login",
                "kbd-at-login"
            ]
        },
        "page-panel": {
            "type": "page",
            "title": "Panel",
            "sections": [
                "sec-panel-icons",
                "sec-panel-network",
                "sec-panel-battery",
                "sec-panel-behaviour"
            ]
        },
        "sec-panel-icons": {
            "type": "section",
            "title": "Panel icons",
            "keys": [
                "panel-network",
                "panel-volume",
                "panel-battery",
                "panel-bluetooth",
                "panel-nightlight",
                "panel-airplane",
                "panel-dnd",
                "panel-caffeine",
                "panel-mic",
                "panel-camera"
            ]
        },
        "sec-panel-network": {
            "type": "section",
            "title": "Network",
            "keys": [
                "panel-net-speed",
                "panel-net-speed-show"
            ]
        },
        "sec-panel-behaviour": {
            "type": "section",
            "title": "Behaviour",
            "keys": [
                "panel-scroll-volume",
                "panel-scroll-touchpad"
            ]
        },
        "page-appearance": {
            "type": "page",
            "title": "Appearance",
            "sections": [
                "sec-look"
            ]
        },
        "sec-look": {
            "type": "section",
            "title": "Look",
            "keys": [
                "card-style",
                "style-system-wide",
                "accent-color",
                "button-shape",
                "tile-style",
                "tile-labels",
                "columns",
                "rows-per-page",
                "keep-page-height",
                "animation-speed"
            ]
        },
        "sec-panel-battery": {
            "type": "section",
            "title": "Battery",
            "keys": [
                "panel-battery-style",
                "panel-battery-percent-mode",
                "panel-battery-time"
            ]
        }
    },
    "toggles-help": {
        "type": "label",
        "description": "Turn a tile's switch on to show it in Quick Settings, and use the arrows to change the order (pages fill automatically, in this order). You can also do this in Quick Settings with the pencil button: drag tiles to reorder them, to another page, or into the hidden tiles. Tiles your computer can't use yet (no Ethernet port, app not installed...) show dimmed."
    },
