    "slider-volume": {
        "type": "switch",
        "default": true,
        "description": "Volume slider"
    },
    "scroll-volume-slider": {
        "type": "combobox",
        "default": "both",
        "description": "Volume slider scrolling",
        "options": {
            "Mouse wheel and touchpad": "both",
            "Mouse wheel only": "wheel",
            "Touchpad only": "touchpad",
            "Off": "off"
        },
        "dependency": "slider-volume",
        "tooltip": "What can change this slider by scrolling over it. When scrolling is off for a device, it scrolls Quick Settings instead."
    },
    "output-picker": {
        "type": "switch",
        "default": true,
        "description": "Sound output picker (arrow on the volume slider)"
    },
    "slider-brightness": {
        "type": "switch",
        "default": true,
        "description": "Brightness slider"
    },
    "scroll-brightness-slider": {
        "type": "combobox",
        "default": "both",
        "description": "Brightness slider scrolling",
        "options": {
            "Mouse wheel and touchpad": "both",
            "Mouse wheel only": "wheel",
            "Touchpad only": "touchpad",
            "Off": "off"
        },
        "dependency": "slider-brightness",
        "tooltip": "What can change this slider by scrolling over it. When scrolling is off for a device, it scrolls Quick Settings instead."
    },
    "mic-slider": {
        "type": "combobox",
        "default": "recording",
        "description": "Microphone slider",
        "options": {
            "When an app is using the microphone": "recording",
            "Always": "always",
            "Never": "never"
        }
    },
    "scroll-mic-slider": {
        "type": "combobox",
        "default": "both",
        "description": "Microphone slider scrolling",
        "options": {
            "Mouse wheel and touchpad": "both",
            "Mouse wheel only": "wheel",
            "Touchpad only": "touchpad",
            "Off": "off"
        },
        "tooltip": "What can change this slider by scrolling over it. When scrolling is off for a device, it scrolls Quick Settings instead."
    },
    "input-picker": {
        "type": "switch",
        "default": true,
        "description": "Microphone input picker (arrow on the microphone slider)"
    },
    "show-battery-pill": {
        "type": "switch",
        "default": true,
        "description": "Battery"
    },
    "show-screenshot": {
        "type": "switch",
        "default": true,
        "description": "Screenshot button"
    },
    "show-settings": {
        "type": "switch",
        "default": true,
        "description": "Settings button"
    },
    "show-lock": {
        "type": "switch",
        "default": true,
        "description": "Lock button"
    },
    "show-power": {
        "type": "switch",
        "default": true,
        "description": "Power button"
    },
    "show-media-card": {
        "type": "switch",
        "default": true,
        "description": "Media player controls when something is playing"
    },
    "panel-network": {
        "type": "switch",
        "default": true,
        "description": "Network"
    },
    "panel-net-speed": {
        "type": "switch",
        "default": false,
        "description": "Show download and upload speed",
        "tooltip": "Shows the current network speed next to the Wi-Fi or wired icon, updated every second (for example \u2193 1.2 MB/s \u2191 34 KB/s). Hidden when you're offline and on vertical panels."
    },
    "panel-net-speed-show": {
        "type": "combobox",
        "default": "both",
        "description": "Speeds to show",
        "dependency": "panel-net-speed",
        "options": {
            "Download and upload": "both",
            "Download only": "down",
            "Upload only": "up"
        }
    },
    "panel-volume": {
        "type": "switch",
        "default": true,
        "description": "Volume"
    },
    "panel-battery": {
        "type": "switch",
        "default": true,
        "description": "Battery"
    },
    "panel-bluetooth": {
        "type": "switch",
        "default": true,
        "description": "Bluetooth (when a device is connected)"
    },
    "panel-nightlight": {
        "type": "switch",
        "default": true,
        "description": "Night Light (when on)"
    },
    "panel-airplane": {
        "type": "switch",
        "default": true,
        "description": "Airplane Mode (when on)"
    },
    "panel-dnd": {
        "type": "switch",
        "default": true,
        "description": "Do Not Disturb (when on)"
    },
    "panel-caffeine": {
        "type": "switch",
        "default": true,
        "description": "Caffeine (when on)"
    },
    "panel-mic": {
        "type": "switch",
        "default": true,
        "description": "Microphone (when an app is using it)"
    },
    "panel-scroll-volume": {
        "type": "switch",
        "default": true,
        "description": "Scroll over the panel icons to change the volume (mouse wheel)",
        "tooltip": "Each mouse-wheel notch over the Quick Settings panel button changes the volume by 5%. Touchpad scrolling has its own option."
    },
    "panel-scroll-touchpad": {
        "type": "switch",
        "default": true,
        "description": "Scroll over the panel icons to change the volume (touchpad, two fingers)",
        "tooltip": "Two-finger scrolling on a touchpad over the Quick Settings panel button changes the volume. Works on its own or together with the mouse wheel option."
    },
    "card-style": {
        "type": "combobox",
        "default": "dark",
        "description": "Menu style",
        "options": {
            "Dark (GNOME default)": "dark",
            "Light": "light",
            "Follow system style": "system"
        },
        "tooltip": "Follow system style matches your system theme: Quick Settings turns light or dark whenever your theme does (including from the Dark Style tile)."
    },
    "style-system-wide": {
        "type": "switch",
        "default": false,
        "description": "Apply the menu style to the whole system",
        "tooltip": "Choosing Dark or Light also switches your apps, windows and Cinnamon theme to their dark or light versions (like the Dark Style tile), and the Dark Style tile changes the menu style too. Has no effect with Follow system style."
    },
    "accent-color": {
        "type": "colorchooser",
        "default": "rgb(53,132,228)",
        "description": "Accent color"
    },
    "button-shape": {
        "type": "combobox",
        "default": "pill",
        "description": "Button shape",
        "options": {
            "Pill (GNOME default)": "pill",
            "Square": "square",
            "Squircle": "squircle",
            "Teardrop": "teardrop",
            "Rhombus": "rhombus",
            "Window": "window"
        },
        "tooltip": "The shape of tiles and buttons in Quick Settings. Pill: rounded tiles and round buttons, like GNOME. Square: small corners. Squircle: soft rounded squares. Teardrop: one tight corner. Rhombus: two opposite corners round, two tight (a slanted diamond look). Window: round on top, square at the bottom."
    },
    "tile-style": {
        "type": "combobox",
        "default": "long",
        "description": "Tile style",
        "options": {
            "Long tiles (GNOME)": "long",
            "Big tiles": "small",
            "Small tiles": "round"
        },
        "tooltip": "Long tiles show the icon, name and status, like GNOME. Big tiles show the icon above the name, one per column. Small tiles are icon-only round buttons that fill the width of Quick Settings (hover for the name). Long and big tiles keep the arrow for menus (Wi-Fi, Bluetooth\u2026); on small tiles, right-click to open the menu."
    },
    "tile-labels": {
        "type": "switch",
        "default": true,
        "description": "Show names on tiles",
        "tooltip": "Long and big tiles: show each tile's name (and status on long tiles). Turn off for icon-only tiles; the name then appears when you hover. Not available for small tiles, which never show names.",
        "gqs-disable-when": {
            "key": "tile-style",
            "equals": "round"
        }
    },
    "columns": {
        "type": "combobox",
        "default": 2,
        "description": "Toggle columns",
        "options": {
            "1 column": 1,
            "2 columns (GNOME default)": 2,
            "3 columns": 3,
            "4 columns": 4,
            "5 columns": 5
        }
    },
    "show-customize": {
        "type": "switch",
        "default": true,
        "description": "Edit button (pencil): drag tiles to rearrange them"
    },
    "panel-camera": {
        "type": "switch",
        "default": true,
        "description": "Camera (when blocked)"
    },
    "panel-battery-style": {
        "type": "combobox",
        "default": "system",
        "description": "Battery icon",
        "options": {
            "System icon (from your theme)": "system",
            "Horizontal": "horizontal",
            "Vertical": "vertical",
            "Circle": "circle"
        }
    },
    "panel-battery-percent-mode": {
        "type": "combobox",
        "default": "off",
        "description": "Battery percentage",
        "options": {
            "Hidden": "off",
            "Beside the icon": "outside",
            "Inside the icon": "inside"
        },
        "tooltip": "Inside the icon is only available with the Horizontal, Vertical and Circle icons; the System icon can show the percentage beside it.",
        "gqs-hide-options": {
            "key": "panel-battery-style",
            "equals": "system",
            "hide": [
                "inside"
            ],
            "fallback": "outside"
        }
    },
    "panel-battery-time": {
        "type": "combobox",
        "default": "off",
        "description": "Battery time remaining",
        "options": {
            "Disabled": "off",
            "On the Quick Settings button (panel)": "panel",
            "Inside Quick Settings": "menu",
            "Both inside and outside Quick Settings": "both"
        },
        "tooltip": "Time left in hours and minutes (for example 3 h 25 min), or the time until full while charging. Inside Quick Settings it shows under the percentage in the battery pill. Hidden while it's still being estimated; the panel text is also hidden on vertical panels."
    },
    "animation-speed": {
        "type": "combobox",
        "default": "normal",
        "description": "Animations",
        "options": {
            "Off": "off",
            "Fast": "fast",
            "Normal (GNOME)": "normal",
            "Slow": "slow"
        }
    },
    "refresh-rate-remember": {
        "type": "switch",
        "default": true,
        "description": "Keep the refresh rate chosen in Quick Settings after restarting"
    },
    "refresh-rate-memory": {
        "type": "generic",
        "default": {}
    },
    "refresh-rate-verified": {
        "type": "generic",
        "default": {}
    },
    "kbd-rgb-state": {
        "type": "generic",
        "default": {}
    },
    "kbd-last-level": {
        "type": "generic",
        "default": null
    },
    "show-notifications": {
        "type": "switch",
        "default": true,
        "description": "Notifications at the bottom (tap the header to expand; tiles shrink to 6 round buttons)"
    },
    "notifications-expanded": {
        "type": "generic",
        "default": false
    },
    "notifications-position": {
        "type": "combobox",
        "default": "bottom",
        "description": "Show notifications",
        "options": {
            "Below Quick Settings": "bottom",
            "Above Quick Settings": "top",
            "Left of Quick Settings": "left",
            "Right of Quick Settings": "right"
        },
        "dependency": "show-notifications"
    },
    "notif-compact": {
        "type": "switch",
        "default": true,
        "dependency": "show-notifications",
        "description": "Compact Quick Settings while notifications are open",
        "tooltip": "On: opening the notification list shrinks the tiles into a row of round buttons and hides the sliders, to make room. Off: Quick Settings stays full size and the list opens below it (scroll if the screen is short). Not used when notifications are on the left or right."
    },
    "media-expanded": {
        "type": "generic",
        "default": false
    },
    "rows-per-page": {
        "type": "combobox",
        "default": 4,
        "description": "Tile rows per page (the rest go to the next page)",
        "options": {
            "1 row": 1,
            "2 rows": 2,
            "3 rows": 3,
            "4 rows (default)": 4,
            "5 rows": 5,
            "6 rows": 6
        }
    },
    "show-configure": {
        "type": "switch",
        "default": true,
        "description": "Quick Settings settings button (opens this window)"
    },
    "keep-page-height": {
        "type": "switch",
        "default": true,
        "description": "Keep every page the same height (a page with fewer tiles keeps empty space)"
    },
    "bt-at-login": {
        "type": "combobox",
        "default": "remember",
        "description": "Bluetooth at login",
        "options": {
            "Remember last state": "remember",
            "Always off": "off",
            "Always on": "on",
            "Leave to the system": "system"
        },
        "tooltip": "Linux turns Bluetooth on at every boot, and Bluetooth Manager (Blueman) may switch it on too. Quick Settings applies your choice for the first minute after login, after waking from suspend and whenever the adapter reappears. 'Always off' also stops Blueman powering it on. To stop it at boot entirely, re-run install.sh with --bt-boot-off."
    },
    "kbd-at-login": {
        "type": "combobox",
        "default": "remember",
        "description": "Keyboard light at login",
        "options": {
            "Remember last state": "remember",
            "Always off": "off",
            "Leave to the laptop": "system"
        },
        "tooltip": "Many laptops turn the keyboard light on at every start-up. Remember puts back the state you left it in (also after waking from suspend); Always off starts with it off. Note: on keyboards that don't report Fn-key changes (such as Legion RGB keyboards), only changes made in Quick Settings are remembered, so choose Always off if you usually keep it off."
    },
    "bt-last-powered": {
        "type": "generic",
        "default": null
    },
    "custom-tiles-help": {
        "type": "label",
        "description": "Make your own tiles: open an app, open a folder or website, or run your own on/off commands. They appear in Quick Settings like the built-in tiles, so you can move or hide them with the pencil button."
    },
    "custom-tiles": {
        "type": "generic",
        "default": []
    },
    "custom-tiles-state": {
        "type": "generic",
        "default": {}
    }
}