<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>GNOME Quick Settings for Linux Mint</vendor>
  <vendor_url>https://henzljw.vercel.app/</vendor_url>

  <!-- Blocking the camera: one click, no password. -->
  <action id="com.henzljw.gqs.camera.off">
    <description>Turn the camera off</description>
    <message>Authentication is required to turn the camera off</message>
    <icon_name>camera-disabled</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/gqs-camera-off</annotate>
  </action>

  <!-- Unblocking the camera: one click, no password. -->
  <action id="com.henzljw.gqs.camera.on">
    <description>Turn the camera on</description>
    <message>Authentication is required to turn the camera on</message>
    <icon_name>camera-web</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/gqs-camera-on</annotate>
  </action>
</policyconfig>
